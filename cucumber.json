{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "requireModule": [
      "ts-node/register"
    ],
    "require": [
      "step-definitions/**/*.ts",
      "src/support/**/*.ts"
    ],
    "paths": [
      "features/**/*.feature"
    ],
    "format": [
      "html:reports/cucumber-report.html",
      "json:reports/cucumber-report.json",
      "progress-bar",
      "allure-cucumberjs/reporter"
    ],
    "publishQuiet": true
  }
}
