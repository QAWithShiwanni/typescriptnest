
{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "dryRun": false,
    "requireModule": [
      "ts-node/register"
    ],
    "require": [
      "src/step-definitions/**/*.ts",
      "src/support/**/*.ts"
    ],
    "paths": [
      "features/**/*.feature"
    ],
    "format": [
      "pretty",
      "html:reports/cucumber-report.html",
      "json:reports/cucumber-report.json"
    ],
    "publishQuiet": true
  }
}
